{
    "$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
    "root": false,
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": true,
        "includes": ["**", "!node_modules", "!.next", "!dist", "!build"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "javascript": {
        "formatter": {
            "trailingCommas": "all",
            "quoteStyle": "single",
            "semicolons": "always",
            "jsxQuoteStyle": "single"
        }
    },
    "css": {
        "linter": {
            "enabled": true
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "style": {
                "noNonNullAssertion": "off"
            },
            "a11y": {
                "noSvgWithoutTitle": "off"
            },
            "complexity": {
                "useArrowFunction": "error"
            },
            "suspicious": {
                "noUnknownAtRules": "off",
                "noImplicitAnyLet": "off",
                "noArrayIndexKey": "off"
            }
        },
        "domains": {
            "react": "recommended"
        }
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
